{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# La API pública (solo /api): el backend ya envía sus Cache-Control. /actuator NO se publica.
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		# Las páginas HTML son dinámicas en Next; este Cache-Control permite que Cloudflare las absorba
		# (pico de la noche electoral). Los ficheros /_next/static llevan el suyo (immutable).
		@pages not path /_next/*
		header @pages >Cache-Control "public, s-maxage=60, stale-while-revalidate=300, stale-if-error=86400"
		reverse_proxy frontend:3000
	}
}
